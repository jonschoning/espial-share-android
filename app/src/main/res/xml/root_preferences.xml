<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

   <PreferenceCategory app:title="@string/config_header">

        <EditTextPreference
            app:defaultValue=""
            app:key="espial_server_url"
            app:title="Espial Server Url"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            app:defaultValue=""
            app:key="espial_api_key"
            app:title="ApiKey"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="espial_canonicalize_urls"
            app:title="Canonicalize Urls"
            app:summary="Resolve share links to their final URL and fetch a title before sending to the server"
            app:useSimpleSummaryProvider="false" />

    </PreferenceCategory>
    <PreferenceCategory app:title="Read Later">
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="espial_readlater_marktoread"
            app:title="Mark as to-read"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

</PreferenceScreen>